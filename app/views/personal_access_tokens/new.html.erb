<%= title [l(:label_my_account), my_account_path],
          [l(:label_personal_access_token_plural), personal_access_tokens_path],
          l(:label_personal_access_token_new) %>

<%= labelled_form_for @personal_access_token, :url => personal_access_tokens_path do |f| %>
  <%= error_messages_for 'personal_access_token' %>
  <div class="box tabular">
    <p><%= f.text_field :name, :required => true, :size => 60, :maxlength => PersonalAccessToken::NAME_LENGTH_LIMIT %></p>
    <p>
      <%= f.date_field :expiration_date, :required => true,
                       :value => @personal_access_token.expiration_date&.iso8601,
                       :min => (User.current.today + 1).iso8601,
                       :max => PersonalAccessToken.latest_expiration_date(User.current).iso8601 %>
      <%= calendar_for('personal_access_token_expiration_date') %>
      <em class="info"><%= l(:text_personal_access_token_max_lifetime, :count => PersonalAccessToken.max_lifetime) %></em>
    </p>
  </div>
  <%= submit_tag l(:button_create) %>
<% end %>

<% content_for :sidebar do %>
<%= render :partial => 'my/sidebar' %>
<% end %>
