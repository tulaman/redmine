<%= title [l(:label_my_account), my_account_path],
          [l(:label_personal_access_token_plural), personal_access_tokens_path],
          @personal_access_token.name %>

<div class="flash warning"><%= l(:text_personal_access_token_copy_now) %></div>

<div class="box" data-controller="api-key-copy">
  <p>
    <%= l(:field_expires_on) %>: <%= format_time(@personal_access_token.expires_on) %>
    <a class="copy-api-key-link icon icon-only"
       title="<%= l(:button_copy) %>"
       aria-label="<%= l(:button_copy) %>"
       href="#"
       role="button"
       tabindex="0"
       data-action="click->api-key-copy#copy">
      <%= sprite_icon('copy') %>
    </a>
  </p>
  <pre id="personal-access-token-value" class="autoscroll" data-api-key-copy-target="apiKey"><%= @personal_access_token.plaintext_token %></pre>
</div>

<p><%= link_to l(:button_back), personal_access_tokens_path %></p>

<% content_for :sidebar do %>
<%= render :partial => 'my/sidebar' %>
<% end %>
