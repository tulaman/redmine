<%# locals: (personal_access_token:, show_user: false, delete_path:) %>
<%= content_tag :tr, :id => "personal-access-token-#{personal_access_token.id}", :class => ('expired' if personal_access_token.expired?) do %>
  <% if show_user %>
  <td class="user">
    <%= link_to_user personal_access_token.user %>
    <% unless personal_access_token.user.active? %>(<%= l("status_#{User::LABEL_BY_STATUS[personal_access_token.user.status]}") %>)<% end %>
  </td>
  <% end %>
  <td class="name"><%= personal_access_token.name %></td>
  <td class="token"><code><%= personal_access_token.masked_value %></code></td>
  <td class="created_on"><%= format_time(personal_access_token.created_on) %></td>
  <td class="expires_on">
    <%= format_time(personal_access_token.expires_on) %>
    <% if personal_access_token.expired? %>(<%= l(:label_personal_access_token_expired) %>)<% end %>
  </td>
  <td class="buttons"><%= delete_link delete_path %></td>
<% end %>
