<%= form_tag({:action => 'edit', :tab => 'api'}) do %>

<div class="box tabular settings">
<p><%= setting_check_box :rest_api_enabled %></p>

<p><%= setting_check_box :jsonp_enabled %></p>

<p><%= setting_text_field :personal_access_token_max_lifetime, :size => 6 %> <%= l(:label_day_plural) %></p>
</div>

<fieldset class="box tabular settings">
<legend><%= l(:label_api_audit_log) %></legend>
<p><%= setting_check_box :api_audit_log_enabled %></p>
<p><%= setting_text_field :api_audit_log_retention_days, :size => 6 %> <%= l(:label_day_plural) %></p>
<p><%= setting_text_field :api_audit_alert_failures_threshold, :size => 6 %>
<em class="info"><%= l(:text_api_audit_alert_failures_threshold) %></em></p>
<p><%= setting_text_field :api_audit_alert_volume_threshold, :size => 6 %>
<em class="info"><%= l(:text_api_audit_alert_volume_threshold) %></em></p>
<p><%= setting_check_box :api_audit_alert_new_ip %></p>
<p><em class="info"><%= l(:text_api_audit_alert_scan) %></em></p>
</fieldset>

<%= submit_tag l(:button_save) %>
<% end %>
